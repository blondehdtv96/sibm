# Server Environment Configuration
# Copy this to .env on your server
# Or run: php fix-server-env.php

APP_NAME="Sistem Informasi SMK Bina Mandiri Kota Bekasi"
APP_ENV=production
APP_KEY=base64:brBsxJjs54fCdnKF8oaliLrW/xoZ67bOD8RJgxM1KtQ=
APP_DEBUG=false
APP_URL=https://www.smkbinamandiribekasi.sch.id

# IMPORTANT: After deployment, run these commands:
# 1. php fix-server-env.php (auto-fix environment)
# 2. php artisan storage:link
# 3. php artisan config:clear
# 4. php artisan cache:clear
# 5. php artisan view:clear
# 6. chmod -R 755 storage bootstrap/cache
# 7. chown -R www-data:www-data storage bootstrap/cache (Linux)

# Safe logging configuration for server (IMPORTANT!)
# Using errorlog to avoid permission issues
LOG_CHANNEL=errorlog
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Disable query logging in production
DATABASE_LOG_QUERIES=false

# Database configuration (update with your server details)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Cache and Session (use file-based for shared hosting)
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail configuration (update with your SMTP details)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Disable unnecessary services for shared hosting
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Chatbot (OpenAI-compatible chat completion API)
# Isi OPENAI_API_KEY untuk mengaktifkan jawaban AI pada chatbot sekolah.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.4
OPENAI_TIMEOUT=30
